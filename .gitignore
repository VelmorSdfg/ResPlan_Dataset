# ── Исходные данные датасета (сотни МБ, не коммитим) ──────────────────
ResPlan.zip
ResPlan.pkl

# ── Сгенерированный вывод пайплайна ───────────────────────────────────
# Игнорируем всё внутри masks_out/, КРОМЕ двух маленьких полезных JSON.
# Важно: шаблон именно `masks_out/*`, а не `masks_out/` — если игнорировать
# каталог целиком, git в него не заходит и правила-исключения (!) не работают.
masks_out/*
!masks_out/class_mapping.json
!masks_out/pixel_frequency.json

# Сплиты не коммитим: они детерминированно восстанавливаются из --seed.
# (train.txt / val.txt попадают под masks_out/* выше.)

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Локальные настройки инструментов / IDE ────────────────────────────
.claude/settings.local.json
.idea/
.vscode/
*.swp
.DS_Store
